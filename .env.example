# Copie para .env.local (ignorado pelo git) e preencha com os valores reais.
# Nunca coloque segredos no .env (ele é versionado no git).

# --- Supabase ---
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
# Segredo - só existe no ambiente de produção (Cloudflare/Lovable), nunca em arquivo versionado.
SUPABASE_SERVICE_ROLE_KEY=

# --- Web Push ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
CRON_SECRET=

# --- Meta Pixel + Conversions API ---
# Pixel ID não é sensível (aparece em qualquer página que carrega o Pixel),
# por isso tem prefixo VITE_ para ir também no bundle do cliente.
VITE_META_PIXEL_ID=
# Fallback server-side (usado se VITE_META_PIXEL_ID não estiver definido no build).
META_PIXEL_ID=
# Segredo - token de acesso server-side da Conversions API. Nunca versionar.
META_CAPI_TOKEN=
